# Names only. Real values live in the macOS Keychain (service "econagent"), never in files.
# Add one with:   ./config/keys.sh set ALPACA_API_KEY
# Required for their server to load:
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FMP_API_KEY=
NEWSAPI_KEY=
# Optional (higher limits / extra features):
BLS_API_KEY=      # free; lifts BLS from 25 to 500 queries/day
FRED_API_KEY=     # free; only used by the custom econ_gov server for ALFRED vintages
